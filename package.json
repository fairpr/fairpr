{
  "name": "proofpr",
  "version": "0.2.0",
  "description": "Stop AI-slop pull requests without punishing honest contributors. A GitHub Action that checks PRs against your repo policy and explains what to fix.",
  "main": "lib/action.js",
  "scripts": {
    "build": "npm run build:action && npm run build:cli",
    "build:action": "tsc --noEmit && ncc build src/main.ts -o dist --license licenses.txt",
    "build:cli": "ncc build src/cli/bin.ts -o .cli-build && node scripts/finish-cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node test/e2e/mock-github.mjs && node test/e2e/cli.mjs"
  },
  "keywords": [
    "github-action",
    "pull-request",
    "ai-slop",
    "maintainers",
    "open-source",
    "code-review",
    "triage"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vercel/ncc": "^0.38.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "proofpr": "bin/proofpr.js"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proofpr/proofpr.git"
  },
  "homepage": "https://github.com/proofpr/proofpr#readme",
  "bugs": {
    "url": "https://github.com/proofpr/proofpr/issues"
  }
}
